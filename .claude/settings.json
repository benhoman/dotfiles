{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NEW_INIT": "1"
  },
  "permissions": {
    "deny": [
      "Read(//Users/bhoman/.local/state/consumeraffairs/mise_env.toml)",
      "Edit(//Users/bhoman/.local/state/consumeraffairs/mise_env.toml)",
      "Write(//Users/bhoman/.local/state/consumeraffairs/mise_env.toml)",
      "Bash(cat *mise_env.toml*)",
      "Bash(less *mise_env.toml*)",
      "Bash(more *mise_env.toml*)",
      "Bash(head *mise_env.toml*)",
      "Bash(tail *mise_env.toml*)",
      "Bash(bat *mise_env.toml*)",
      "Bash(grep * *mise_env.toml*)",
      "Bash(rg * *mise_env.toml*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/Documents/vaults/main"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-ticket-prefix.sh",
            "if": "Bash(git commit*)"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "worktree@ca-worktrees": true,
    "pyright-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ca-marketplace": {
      "source": {
        "source": "directory",
        "path": "/Users/bhoman/src/github.com/bhoman-ca/ai/main/claude/plugins/ca-marketplace"
      }
    },
    "ca-worktrees": {
      "source": {
        "source": "directory",
        "path": "/Users/bhoman/src/github.com/bhoman-ca/worktrees/dev"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
