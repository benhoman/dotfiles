# Cross-platform open
_open_url() {
  if command -v open >/dev/null 2>&1; then
    open "$1"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$1" >/dev/null 2>&1
  else
    echo "No URL opener found (tried open, xdg-open)" >&2
    return 1
  fi
}

# pbcopy/pbpaste — macOS has these natively; define on Linux only
if [ "$(uname)" != "Darwin" ]; then
  if command -v xclip >/dev/null 2>&1; then
    eval 'pbcopy()  { xclip -selection clipboard; }'
    eval 'pbpaste() { xclip -selection clipboard -o; }'
  elif command -v xsel >/dev/null 2>&1; then
    eval 'pbcopy()  { xsel --clipboard --input; }'
    eval 'pbpaste() { xsel --clipboard --output; }'
  fi
fi

# Create dir and cd into it
mkcd() { mkdir -p "$1" && cd "$1"; }

# cd to a throwaway temp dir
tmp() { cd "$(mktemp -d)"; }

# Ripgrep + fzf
rgfzf() {
  if [ ! "$#" -gt 0 ]; then
    echo "Usage: rgfzf <query>" >&2
    return 1
  fi
  rg --files-with-matches --no-messages "$1" \
    | fzf --prompt "$1 > " \
          --reverse --multi \
          --preview "rg --ignore-case --pretty --context 10 '$1' {}"
}

# Open current repo in browser
repo() {
  local base_url
  base_url=$(git config --get remote.origin.url)
  base_url=${base_url%.git}
  base_url=${base_url//git@github.com:/https://github.com/}
  base_url=${base_url//git://github.com/https://github.com/}
  base_url=${base_url//git@bitbucket.org:/https://bitbucket.org/}
  base_url=${base_url//git@gitlab.com:/https://gitlab.com/}

  if ! git branch >/dev/null 2>&1; then
    echo "Not a git repo!" >&2
    return 1
  fi

  local full_path git_base_path relative_path branch tree url
  full_path=$(pwd)
  git_base_path=$(cd "./$(git rev-parse --show-cdup)" && pwd)
  relative_path=${full_path#"$git_base_path"}
  [ -n "$1" ] && relative_path="$relative_path/$1"

  branch=$(git name-rev --name-only --no-undefined --always HEAD 2>/dev/null)
  branch=${branch#refs/heads/}
  branch=${branch#remotes/origin/}

  case "$base_url" in
    *bitbucket*) tree="src" ;;
    *)           tree="tree" ;;
  esac

  url="$base_url/$tree/$branch$relative_path"
  _open_url "$url"
}

# Pretty-print JSON
json() {
  if [ -t 0 ]; then
    echo "$*" | jq .
  else
    jq .
  fi
}

# Check if inside tmux
in_tmux() {
  [ -n "$TMUX" ]
}

# Attach to a tmux session by name, or pick one with fzf.
# If the session doesn't exist, load a matching tmuxp profile (ca_<name> or
# exact match) or fall back to creating a plain new session.
# With no args, fzf over active sessions + tmuxp profiles.
ta() {
  local name tmuxp_dir ca_profile exact_profile profile

  tmuxp_dir="${TMUXP_CONFIGDIR:-$HOME/.config/tmuxp}"

  if [ -z "$1" ]; then
    local sessions profiles choices chosen
    sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null)
    profiles=$(find "$tmuxp_dir" -maxdepth 1 -name '*.yaml' -o -name '*.yml' 2>/dev/null \
      | xargs -I{} basename {} \
      | sed 's/\.[^.]*$//')
    choices=$(
      { [ -n "$sessions" ] && printf '%s\n' "$sessions" | sed 's/^/session: /'; \
        printf '%s\n' "$profiles" | sed 's/^/tmuxp:  /'; } \
      | sort -u
    )
    chosen=$(printf '%s\n' "$choices" | fzf --prompt 'ta> ')
    [ -z "$chosen" ] && return 0
    name=$(printf '%s' "$chosen" | sed 's/^[^:]*:  *//')
    # If it was a session line, just attach
    if printf '%s' "$chosen" | grep -q '^session:'; then
      tmux attach-session -t "$name"
      return
    fi
    # Otherwise fall through with $name set to the profile basename
  else
    name="$1"
  fi

  # Already have a live session?
  if tmux has-session -t "$name" 2>/dev/null; then
    tmux attach-session -t "$name"
    return
  fi

  # Look for a tmuxp profile: prefer ca_<name>, then exact match
  ca_profile="$tmuxp_dir/ca_${name}.yaml"
  exact_profile="$tmuxp_dir/${name}.yaml"

  if [ -f "$ca_profile" ]; then
    profile="$ca_profile"
  elif [ -f "$exact_profile" ]; then
    profile="$exact_profile"
  fi

  if [ -n "$profile" ]; then
    tmuxp load "$profile"
  else
    tmux new-session -s "$name"
  fi
}

# Throwaway Python env via uv in a temp dir
python_throwaway() {
  local dir
  dir=$(mktemp -d -t throwaway-XXXXXXX)
  cd "$dir"
  uv init --quiet
  uv venv --quiet
  . .venv/bin/activate
}

# Git colored diff (overrides diff when git is available)
if command -v git >/dev/null 2>&1; then
  diff() { git diff --no-index --color-words "$@"; }
fi
